---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';
import '../styles/home.css';
---

<BaseLayout title={`Page not found — ${AUTHOR}`} description="That page doesn't exist." noindex>
  <section class="panel not-found">
    <div class="panel-head">
      <span class="path"><span class="dot red"></span><b>Error</b></span>
      <span class="aside"><span class="dot red pulse"></span> 404</span>
    </div>
    <div class="cta-body">
      <div class="screen nf-screen">
        <p><span class="ps1">visitor@webkwizards:~$</span> <span class="cmd">cd</span> this-page</p>
        <p class="err">cd: no such file or directory</p>
      </div>
      <div>
        <h1>This page doesn't exist.</h1>
        <p>The link is either broken or the page has moved. Nothing lost — here's the way back.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/">Back home →</a>
          <a class="btn" href="/blog/">Read the blog</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
