---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, postNumber, postUrl, tagUrl } from '../../lib/posts';
import { formatDate, isoDate, readingTime } from '../../lib/format';
import { AUTHOR } from '../../consts';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // `posts` is newest-first, so the previous index is the newer post.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
      number: postNumber(post, posts),
    },
  }));
}

const { post, newer, older, number } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const { title, description, pubDate, updatedDate, tags, draft, image } = post.data;
---

<BaseLayout
  title={`${title} — ${AUTHOR}`}
  description={description}
  ogType="article"
  image={image}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  noindex={draft}
>
  <article class="panel post">
    <div class="panel-head">
      <span class="path"><span class="dot red"></span><span><a href="/blog/">~/notes</a>/{post.id}</span></span>
      <span class="aside">N° {number}</span>
    </div>

    <header class="post-head">
      <h1>{title}{draft && <span class="draft-flag">Draft</span>}</h1>
      <p class="lede">{description}</p>

      <div class="post-meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span class="sep">·</span>
        <span>{readingTime(post.body)}</span>
        {
          updatedDate && (
            <>
              <span class="sep">·</span>
              <span>
                Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <a class="key" href={tagUrl(tag)}>
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class:list={['post-body', { 'has-toc': toc.length > 0 }]}>
      <div class="prose">
        <Content />
      </div>

      {
        toc.length > 0 && (
          <aside class="toc" aria-label="On this page">
            <div class="toc-inner screen">
              <span class="toc-label">On this page</span>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
    </div>

    <div class="panel-foot">
      <a href="/blog/">← All posts</a>
      <a href="/#contact">Need a hand with this? Book a call →</a>
    </div>
  </article>

  {
    (older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older && (
          <a href={postUrl(older)} class="panel">
            <span class="dir">← Older</span>
            <span class="to-title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a href={postUrl(newer)} class="panel next">
            <span class="dir">Newer →</span>
            <span class="to-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<script>
  // Highlight the TOC entry for the section currently being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const update = () => {
      // Last heading that has scrolled past the sticky nav (+ some slack).
      const cutoff = 140;
      let current = sections[0];
      for (const el of sections) {
        if (el.getBoundingClientRect().top <= cutoff) current = el;
      }
      links.forEach((a, id) => a.classList.toggle('active', id === current.id));
    };
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>
