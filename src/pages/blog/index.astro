---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesIndex from '../../components/NotesIndex.astro';
import { getPublishedPosts } from '../../lib/posts';
import { BLOG_DESCRIPTION, BLOG_TITLE } from '../../consts';
import '../../styles/blog.css';

const posts = await getPublishedPosts();
---

<BaseLayout title={BLOG_TITLE} description={BLOG_DESCRIPTION}>
  <NotesIndex title="Notes from the engine room." description={BLOG_DESCRIPTION} posts={posts} />
</BaseLayout>
