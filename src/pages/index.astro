---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/Terminal.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
import { CAL_URL, EMAIL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';

const latest = (await getPublishedPosts()).slice(0, 3);

const services = [
  {
    icon: 'layers',
    title: 'Technical strategy & architecture',
    body: "Translate the product vision into a pragmatic architecture and roadmap. Choose the stack, the boundaries, and the trade-offs that won't box you in at the next stage.",
  },
  {
    icon: 'rocket',
    title: 'From prototype to production',
    body: 'Take an LLM demo or notebook and turn it into a reliable, observable, secure product — evals, guardrails, latency and cost under control, not just a happy-path demo.',
  },
  {
    icon: 'terminal',
    title: 'Hands-on building',
    body: 'I still write code. When the team is small, I build the hard parts myself — APIs, data pipelines, infra — and set the patterns the rest of the codebase follows.',
  },
  {
    icon: 'cloud',
    title: 'Cloud, infra & DevOps',
    body: 'AWS, Terraform/CDK, CI/CD, and observability done properly from day one. Ship fast without accumulating the kind of debt that stalls you six months in.',
  },
  {
    icon: 'people',
    title: 'Team & hiring',
    body: 'Define the first engineering hires, interview and calibrate candidates, and set up the autonomous, DevOps-minded team culture that lets a small group move fast.',
  },
  {
    icon: 'lens',
    title: 'Technical due diligence',
    body: 'A clear-eyed read on an architecture, codebase, or AI claims — for founders preparing to raise, or for investors who need a credible technical assessment.',
  },
] as const;

const engagements = [
  {
    mode: 'Advisory',
    title: 'The sounding board',
    meta: '~a few hours / week',
    items: ['Architecture & stack reviews', 'Weekly strategy sessions', 'On-call for the big decisions', 'Hiring & interview support'],
  },
  {
    mode: 'Fractional CTO',
    title: 'Embedded leadership',
    meta: '1–3 days / week',
    items: ['Own the technical roadmap', 'Lead & mentor the team', 'Hands-on with the hard parts', 'Represent tech to investors'],
    feat: true,
  },
  {
    mode: 'Project',
    title: 'Build the foundation',
    meta: 'Fixed scope',
    items: ['0→1 MVP or core system', 'LLM feature productionization', 'Cloud / infra setup', 'Technical due diligence'],
  },
];

const work = [
  {
    when: '2025 — Now',
    role: 'Senior Backend Engineer',
    at: 'HubSpot',
    where: 'Edinburgh, UK (remote) · HubSpot Academy',
    desc: "Led Academy's 13-month migration from hand-written REST APIs to HubSpot's typed RPC framework, deleting ~15k lines of legacy code across 37 production changes. Moved the course catalog to serve customers from their own region via an asynchronous MySQL binlog pipeline — up to ~78% faster in Asia-Pacific, with zero downtime. Built an AI validation agent that checks every practice exercise on create or update and reports pass/fail with a reason.",
    now: true,
  },
  {
    when: '2024 — Now',
    role: 'Chief Technology Officer (part-time)',
    at: 'sky-tech.ai',
    where: 'Edinburgh, UK (remote) · AI document intelligence — medical, insurance & legal',
    desc: 'Lead architecture and engineering for a platform that turns unstructured documents into structured, actionable insight — cutting case-review time by up to 70% while keeping workflows HIPAA/GDPR-compliant and secure. Own the full stack: LLM pipelines, backend services, cloud infrastructure, and team.',
    now: true,
  },
  {
    when: '2023 — 2024',
    role: 'Senior Software Engineer',
    at: 'Bird (MessageBird)',
    where: 'Edinburgh, UK (remote) · Full-stack · React / Go',
    desc: 'Built Bird CRM — a unified platform for marketing, sales, and payments — working across a large-scale, event-driven microservice architecture serving a global customer base.',
  },
  {
    when: '2022 — 2023',
    role: 'Senior Software Engineer',
    at: 'Proportunity',
    where: 'Edinburgh, UK (remote) · Fintech start-up · TypeScript / Node.js',
    desc: 'Technology-driven mortgage lender. Built the backend — web crawlers and a GraphQL API in TypeScript/Node.js with Postgres on AWS — owning features end-to-end in a small, fast-moving team.',
  },
  {
    when: '2020 — 2022',
    role: 'Software Development Engineer II',
    at: 'Amazon (Ads)',
    where: 'Edinburgh, UK · Kotlin / React',
    desc: 'Designed and shipped "shareable snapshots" — effectively a time machine for the advertising reporting UI — across a Kotlin backend and a React/TypeScript front end at Amazon scale.',
  },
  {
    when: '2018 — 2019',
    role: 'Front End Engineer',
    at: 'Toptal',
    where: 'Moscow, Russia (remote) · React',
    desc: 'Halved first contentful paint on the home page with an "above the fold" rendering technique, and helped ship the new Toptal blog — 1.5× faster page loads.',
  },
  {
    when: '2013 — 2018',
    role: 'Front End Engineer → Team Lead → Senior Software Engineer',
    at: 'Yandex',
    where: 'Moscow, Russia · JavaScript / Node.js',
    desc: 'Built a single-page app that grew to 2.5M visits a day, along with the in-house JavaScript MVC framework and component library behind it. As team lead, grew the front-end team from 2 to 6 and cut feature cycle time. Then built an internal CI/CD platform and Node.js CLI tooling for front-end developers.',
  },
  {
    when: '2011 — 2013',
    role: 'Web Developer → Team Lead',
    at: 'Webstroy',
    where: 'Rostov-on-Don, Russia · HTML / jQuery / PHP',
    desc: 'Where it started: building websites from design to production — PSD to HTML, jQuery and PHP. Within a year, led a small team of two developers and ran the projects end to end.',
  },
];

const oss = [
  {
    name: 'tldr',
    label: 'Go · AWS',
    icon: 'spark',
    desc: 'A Telegram bot that summarizes voice messages and round videos in a funny way. Two Go Lambdas, Amazon Transcribe, and Nova Lite on Bedrock, deployed with Terraform.',
  },
  {
    name: 'relational-formula-engine',
    label: 'TypeScript',
    icon: 'db',
    desc: 'A formula engine for applications with user-defined objects, typed attributes, and relations between records.',
  },
  {
    name: 'systemdesigntrainer.com',
    label: 'TypeScript',
    icon: 'layers',
    desc: 'Practice real system design interviews under pressure, before the real one.',
  },
  {
    name: 'vitosik-js',
    label: 'C++',
    icon: 'chip',
    desc: 'A minimal JavaScript engine written in C++, built to learn how engines work from the inside.',
  },
  {
    name: 'coding-interviews-blog-archive',
    label: '1k+ stars',
    icon: 'book',
    desc: 'Walkthroughs of algorithm problems for Big Tech coding interviews, written in Russian.',
  },
  {
    name: 'jblocks',
    label: 'JavaScript',
    icon: 'boxes',
    desc: 'A tiny library for building UI components in a declarative way.',
  },
] as const;

const stack = {
  'Core stack': ['Java / Kotlin / Spring', 'Go', 'TypeScript', 'React', 'Node.js'],
  'Infra & AI': ['AWS', 'Terraform / CDK', 'CI/CD', 'LLM pipelines', 'Observability'],
  Approach: ['Event-driven', 'Microservices', 'End-to-end ownership'],
};

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- HERO -->
  <section class="hero">
    <div class="panel device">
      <div class="panel-head">
        <span class="path"><span class="dot red"></span><b>Status</b></span>
        <span class="aside"><span class="dot orange pulse"></span> Available</span>
      </div>

      <div class="device-body">
        <div class="lcd" aria-hidden="true">Advisory · Fractional · Projects</div>

        <h1>Fractional CTO &amp; technical advisor for <span class="hl">AI startups</span></h1>
        <p class="lede">
          I help early-stage founders turn an AI idea into a system that ships, scales, and survives diligence — senior
          technical leadership without the full-time hire. 15 years building production systems — today Senior Backend
          Engineer at HubSpot and part-time CTO at an AI company, previously Amazon and Yandex.
        </p>

        <div class="controls">
          <div class="round-row">
            <a class="round" href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="LinkedIn profile">in</a>
            <a class="round play" href={CAL_URL} target="_blank" rel="noopener" aria-label="Book an intro call">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"></path></svg>
            </a>
            <a class="round" href={`mailto:${EMAIL}`} aria-label="Email me">@</a>
          </div>
          <a class="caption" href={CAL_URL} target="_blank" rel="noopener">Book a 30-min intro call</a>
        </div>

        <div class="strip">
          <span>Prev · Amazon · Bird · Toptal · Yandex</span>
          <span class="right">2011 / Now</span>
        </div>
        <div class="progress" aria-hidden="true"><span></span></div>
      </div>
    </div>

    <Terminal />
  </section>

  <!-- SERVICES -->
  <section id="services" class="panel">
    <div class="panel-head">
      <span class="path"><span class="dot orange"></span>~/services</span>
      <span class="aside">{pad(services.length)} entries</span>
    </div>
    <div class="intro">
      <h2>Senior technical leadership, on the terms your stage needs.</h2>
      <p>
        Most early AI startups don't need a full-time CTO yet — they need someone senior who has shipped real systems to
        make the right calls before they become expensive. That's where I come in.
      </p>
    </div>
    <div class="cards">
      {
        services.map((s, i) => (
          <div class="card">
            <div class="card-top">
              <PixelIcon name={s.icon} />
              <span class="no">N° {pad(i + 1)}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section id="engage" class="panel">
    <div class="panel-head">
      <span class="path"><span class="dot yellow"></span>~/engagements</span>
      <span class="aside">No long lock-ins</span>
    </div>
    <div class="intro">
      <h2>Flexible engagements that match your runway.</h2>
      <p>
        Start small, scale up if it's working. No long lock-ins — the goal is to make myself progressively less
        necessary.
      </p>
    </div>
    <div class="cards engage">
      {
        engagements.map((e) => (
          <div class:list={['card', { feat: e.feat }]}>
            <div class="mode">
              <span class:list={['dot', e.feat ? 'orange' : '']} />
              {e.mode}
            </div>
            <h3>{e.title}</h3>
            <div class="meta">{e.meta}</div>
            <ul>
              {e.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- WORK / TRACK RECORD -->
  <section id="work" class="panel">
    <div class="panel-head">
      <span class="path"><span class="dot blue"></span>~/work</span>
      <span class="aside">2011 — Now</span>
    </div>
    <div class="intro">
      <h2>Fifteen years of shipping systems that hold up.</h2>
      <p>
        From a single-page app serving 2.5M visits a day at Yandex, through advertising reporting at Amazon, to
        multi-region infrastructure at HubSpot and leading engineering at an AI company today — full ownership, end to
        end.
      </p>
    </div>
    <ol class="timeline">
      {
        work.map((w) => (
          <li class="item">
            <div class="when">
              <span class:list={['dot', w.now ? 'green pulse' : '']} />
              {w.when}
            </div>
            <div>
              <h3 class="role">
                {w.role} <span class="at">· {w.at}</span>
              </h3>
              <div class="where">{w.where}</div>
              <p class="desc">{w.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- LATEST NOTES -->
  {
    latest.length > 0 && (
      <section id="notes" class="panel">
        <div class="panel-head">
          <span class="path">
            <span class="dot red" />
            ~/notes
          </span>
          <a class="aside" href="/blog/">All posts →</a>
        </div>
        <div class="intro">
          <h2>Notes from the engine room.</h2>
        </div>
        <PostList posts={latest} heading="h3" />
      </section>
    )
  }

  <!-- OPEN SOURCE -->
  <section id="oss" class="panel">
    <div class="panel-head">
      <span class="path"><span class="dot green"></span>~/oss</span>
      <a class="aside" href="https://github.com/vitkarpov" target="_blank" rel="noopener">GitHub ↗</a>
    </div>
    <div class="intro">
      <h2>Side projects, in the open.</h2>
      <p>
        Things I build to learn, to scratch an itch, or just for fun. More on
        <a href="https://github.com/vitkarpov" target="_blank" rel="noopener">GitHub</a>.
      </p>
    </div>
    <div class="cards">
      {
        oss.map((o) => (
          <a class="card link" href={`https://github.com/vitkarpov/${o.name}`} target="_blank" rel="noopener">
            <div class="card-top">
              <PixelIcon name={o.icon} />
              <span class="no">{o.label}</span>
            </div>
            <h3>{o.name} ↗</h3>
            <p>{o.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="panel">
    <div class="panel-head">
      <span class="path"><span class="dot yellow"></span>~/about</span>
      <span class="aside">Edinburgh, UK</span>
    </div>
    <div class="intro">
      <h2>The best technical leadership makes itself unnecessary.</h2>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <p>
          I'm Viktor — a software engineer with <strong>15 years</strong> of building high-quality products and
          untangling hard technical problems. I started in UI and front-end infrastructure (an internal CI/CD platform,
          before GitHub Actions made that mainstream), then moved deep into backend:
          <strong>scalable systems, APIs, and event-driven microservices</strong> — always with performance, reliability,
          and observability front of mind.
        </p>
        <p>
          Today I'm a Senior Backend Engineer at HubSpot and a part-time CTO at an AI company, which means I live the
          early-stage AI startup reality every day: shipping LLM-powered features that have to be accurate, secure, and
          fast — not just impressive in a demo. I bring that same lens to founders as a
          <strong>fractional CTO and advisor</strong>.
        </p>
        <p>
          I care about <strong>DevOps culture and fully autonomous teams</strong> — I even ran a podcast about it.
        </p>
      </div>
      <div class="screen stack-box">
        {
          Object.entries(stack).map(([label, chips]) => (
            <div class="stack-group">
              <h4>{label}</h4>
              <div class="chips">
                {chips.map((c) => (
                  <span class="key">{c}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="panel cta">
    <div class="panel-head">
      <span class="path"><span class="dot orange pulse"></span>~/contact</span>
      <span class="aside">Free · 30 min</span>
    </div>
    <div class="cta-body">
      <div>
        <h2>Building something with AI? Let's make sure it's built right.</h2>
        <p>
          Book a free 30-minute intro call. Tell me where you are and what's keeping you up at night — I'll tell you
          straight whether and how I can help.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href={CAL_URL} target="_blank" rel="noopener">Book an intro call →</a>
        <a class="btn" href={`mailto:${EMAIL}`}>Email me</a>
        <a class="btn" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
