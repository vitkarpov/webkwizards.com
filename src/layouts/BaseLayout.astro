---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR, BLOG_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** `article` on blog posts, `website` everywhere else. */
  ogType?: 'website' | 'article';
  /** Site-root-relative or absolute URL to a social preview image. */
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Keep a page out of search indexes and the sitemap (drafts, 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  image,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const favicon =
  'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2218%22 fill=%22%23fdfdfa%22/><circle cx=%2280%22 cy=%2220%22 r=%228%22 fill=%22%23e0803a%22/><text x=%2250%22 y=%2271%22 font-family=%22monospace%22 font-size=%2252%22 font-weight=%22700%22 fill=%22%231a1a1a%22 text-anchor=%22middle%22>VK</text></svg>';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Google tag -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-5QRP9F45"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#fdfdfa" />
    <link rel="icon" href={favicon} />

    <link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Major+Mono+Display&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <Header />
    <main id="top">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
