---
import { AUTHOR, CAL_URL } from '../consts';

// Highlight the Blog tab for /blog/ and every post underneath it.
const onBlog = Astro.url.pathname.startsWith('/blog/');
---

<header>
  <div class="nav">
    <a href="/" class="brand" aria-label={AUTHOR}>
      <span class="mark">VK</span> <span class="brand-name">{AUTHOR}</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/#services">Services</a>
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
      <a href="/blog/" class="nav-blog" aria-current={onBlog ? 'page' : undefined}>Blog</a>
      <a href={CAL_URL} target="_blank" rel="noopener" class="nav-cta">Book a call</a>
    </nav>
  </div>
</header>
