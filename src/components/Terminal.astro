---
import { CAL_URL, EMAIL, LINKEDIN_URL } from '../consts';
import { getPublishedPosts, postUrl } from '../lib/posts';
import { formatDate } from '../lib/format';

/**
 * Hero terminal. The `whoami` block is static HTML so it reads fine without
 * JavaScript; the script turns the prompt line into a tiny shell.
 */

const notes = (await getPublishedPosts()).slice(0, 5).map((p) => ({
  title: p.data.title,
  url: postUrl(p),
  date: formatDate(p.data.pubDate),
}));

const data = {
  cal: CAL_URL,
  email: EMAIL,
  linkedin: LINKEDIN_URL,
  notes,
};

const whoami: [string, string][] = [
  ['name', 'Viktor Karpov'],
  ['role', 'Fractional CTO · technical advisor'],
  ['focus', 'AI startups · LLM pipelines · AWS'],
  ['now', 'HubSpot · sky-tech.ai'],
  ['based', 'Edinburgh, UK'],
];
---

<div class="panel term" data-term={JSON.stringify(data)}>
  <div class="panel-head">
    <span class="path"><span class="dot yellow"></span><b>viktor.sh</b></span>
    <span class="aside"><span class="dot blue"></span> Ready</span>
  </div>

  <div class="term-body">
    <div class="screen term-screen">
      <div class="term-out" aria-live="polite">
        <div class="wordmark" aria-hidden="true">
          <span class="big">karpov</span><span class="ext">.sh</span>
          <span class="est">est. 2011 · v15.0</span>
        </div>
        <div class="ln"><span class="ps1">visitor@webkwizards:~$</span> <span class="cmd">whoami</span></div>
        <dl class="kv">
          {
            whoami.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
          }
          <dt>contact</dt>
          <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
        </dl>
      </div>
      <form class="term-prompt" autocomplete="off">
        <label for="term-input" class="caret">›</label>
        <input
          id="term-input"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          placeholder="type 'help' to see what's available."
          aria-label="Terminal command"
        />
      </form>
    </div>

    <div class="term-hints" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> history</span>
      <span><kbd>Tab</kbd> complete</span>
      <span><kbd>Ctrl</kbd> + <kbd>L</kbd> clear</span>
    </div>
  </div>
</div>

<script>
  type Note = { title: string; url: string; date: string };
  type Data = { cal: string; email: string; linkedin: string; notes: Note[] };
  type Part = string | { text: string; href?: string; cls?: string; external?: boolean };

  const root = document.querySelector<HTMLElement>('.term');
  if (root) {
    const data: Data = JSON.parse(root.dataset.term ?? '{}');
    const out = root.querySelector<HTMLElement>('.term-out')!;
    const form = root.querySelector<HTMLFormElement>('.term-prompt')!;
    const input = root.querySelector<HTMLInputElement>('#term-input')!;
    const screen = root.querySelector<HTMLElement>('.term-screen')!;

    const history: string[] = [];
    let cursor = 0;

    const line = (...parts: Part[]) => {
      const el = document.createElement('div');
      el.className = 'ln';
      for (const part of parts) {
        if (typeof part === 'string') {
          el.append(part);
          continue;
        }
        const node = document.createElement(part.href ? 'a' : 'span');
        node.textContent = part.text;
        if (part.cls) node.className = part.cls;
        if (node instanceof HTMLAnchorElement && part.href) {
          node.href = part.href;
          if (part.external) {
            node.target = '_blank';
            node.rel = 'noopener';
          }
        }
        el.append(node);
      }
      out.append(el);
    };
    const row = (key: string, ...rest: Part[]) => line({ text: key.padEnd(Math.max(10, key.length + 2)), cls: 'k' }, ...rest);
    const muted = (text: string) => line({ text, cls: 'muted' });

    const SECTIONS = ['services', 'engage', 'work', 'notes', 'oss', 'about', 'contact'];

    const commands: Record<string, { help: string; run: (args: string[]) => void }> = {
      help: {
        help: 'list commands',
        run: () => {
          for (const [name, c] of Object.entries(commands)) {
            if (c.help) row(name, { text: c.help, cls: 'muted' });
          }
        },
      },
      whoami: {
        help: 'who is this',
        run: () => {
          row('name', 'Viktor Karpov');
          row('role', 'Fractional CTO · technical advisor');
          row('focus', 'AI startups · LLM pipelines · AWS');
          row('now', 'Senior Backend Engineer @ HubSpot · CTO @ sky-tech.ai');
          row('before', 'Amazon · Bird · Toptal · Yandex');
          row('years', '15 and counting');
        },
      },
      services: {
        help: 'what I do',
        run: () => {
          [
            'Technical strategy & architecture',
            'From prototype to production',
            'Hands-on building',
            'Cloud, infra & DevOps',
            'Team & hiring',
            'Technical due diligence',
          ].forEach((s, i) => row(`0${i + 1}`, { text: s, href: '#services' }));
        },
      },
      work: {
        help: "where I've worked",
        run: () => {
          [
            ['2025—now', 'HubSpot · Senior Backend Engineer'],
            ['2024—now', 'sky-tech.ai · CTO (part-time)'],
            ['2023—24', 'Bird · Senior Software Engineer'],
            ['2022—23', 'Proportunity · Senior Software Engineer'],
            ['2020—22', 'Amazon Ads · SDE II'],
            ['2018—19', 'Toptal · Front End Engineer'],
            ['2013—18', 'Yandex · FE → Team Lead → Senior'],
          ].forEach(([when, what]) => row(when, { text: what, href: '#work' }));
        },
      },
      notes: {
        help: 'latest posts',
        run: () => {
          if (!data.notes.length) return muted('nothing published yet.');
          data.notes.forEach((n) => row(n.date, { text: n.title, href: n.url }));
          line({ text: 'all posts →', href: '/blog/', cls: 'muted' });
        },
      },
      oss: {
        help: 'side projects',
        run: () => {
          [
            ['tldr', 'voice-message summary bot · Go · AWS'],
            ['relational-formula-engine', 'formulas over typed records · TS'],
            ['systemdesigntrainer.com', 'system design interview practice'],
            ['vitosik-js', 'tiny JavaScript engine · C++'],
          ].forEach(([repo, what]) =>
            line({ text: repo, href: `https://github.com/vitkarpov/${repo}`, external: true }, { text: `  ${what}`, cls: 'muted' }),
          );
        },
      },
      contact: {
        help: 'how to reach me',
        run: () => {
          row('email', { text: data.email, href: `mailto:${data.email}` });
          row('linkedin', { text: 'in/vitkarpov', href: data.linkedin, external: true });
          row('call', { text: data.cal.replace('https://', ''), href: data.cal, external: true });
        },
      },
      book: {
        help: 'book a free 30-min intro call',
        run: () => {
          line('opening ', { text: data.cal.replace('https://', ''), href: data.cal, external: true }, ' …');
          window.open(data.cal, '_blank', 'noopener');
        },
      },
      ls: {
        help: 'list sections',
        run: () => line(SECTIONS.map((s) => `${s}/`).join('  ')),
      },
      cd: {
        help: 'jump to a section, e.g. cd work',
        run: ([target = '']) => {
          const id = target.replace(/\/$/, '');
          if (id === 'blog') return void (location.href = '/blog/');
          const el = id && document.getElementById(id);
          if (!el) return line({ text: `cd: no such section: ${target || '~'}`, cls: 'err' });
          el.scrollIntoView({ behavior: 'smooth' });
        },
      },
      clear: { help: 'clear the screen', run: () => out.replaceChildren() },
      // Undocumented extras.
      pwd: { help: '', run: () => line('/home/visitor') },
      date: { help: '', run: () => line(new Date().toString()) },
      echo: { help: '', run: (args) => line(args.join(' ')) },
      sudo: {
        help: '',
        run: () => line('visitor is not in the sudoers file. try ', { text: 'book', cls: 'cmd' }, ' instead.'),
      },
      exit: { help: '', run: () => line('there is no escape. try ', { text: 'book', cls: 'cmd' }, '.') },
    };
    const aliases: Record<string, string> = { blog: 'notes', posts: 'notes', hire: 'book', '?': 'help' };

    const scrollToEnd = () => (out.scrollTop = out.scrollHeight);

    const run = (raw: string) => {
      const text = raw.trim();
      line({ text: 'visitor@webkwizards:~$', cls: 'ps1' }, ' ', { text, cls: 'cmd' });
      if (!text) return;
      history.push(text);
      const [name, ...args] = text.split(/\s+/);
      const cmd = commands[aliases[name.toLowerCase()] ?? name.toLowerCase()];
      if (cmd) cmd.run(args);
      else line({ text: `command not found: ${name}`, cls: 'err' }, ' — try ', { text: 'help', cls: 'cmd' });
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run(input.value);
      input.value = '';
      cursor = history.length;
      scrollToEnd();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        if (!history.length) return;
        e.preventDefault();
        cursor = Math.max(0, Math.min(history.length, cursor + (e.key === 'ArrowUp' ? -1 : 1)));
        input.value = history[cursor] ?? '';
      } else if (e.key === 'Tab' && input.value) {
        const matches = Object.keys(commands).filter((c) => commands[c].help && c.startsWith(input.value));
        if (matches.length) e.preventDefault();
        if (matches.length === 1) input.value = matches[0] + ' ';
        else if (matches.length > 1) {
          muted(matches.join('  '));
          scrollToEnd();
        }
      } else if (e.key.toLowerCase() === 'l' && e.ctrlKey) {
        e.preventDefault();
        out.replaceChildren();
      }
    });

    // Clicking anywhere on the screen (but not a link) focuses the prompt.
    screen.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a') && !getSelection()?.toString()) input.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .term { display: flex; flex-direction: column; }
  .term-body { padding: 18px 22px 16px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  @media (max-width: 600px) { .term-body { padding: 12px 12px 14px; } }

  .term-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 420px;
    max-height: 520px;
    overflow: hidden;
    cursor: text;
  }
  .term-out {
    flex: 1;
    overflow-y: auto;
    padding: 26px 26px 12px;
    font-size: 0.92rem;
    line-height: 1.75;
    scrollbar-width: thin;
  }
  @media (max-width: 600px) { .term-out { padding: 18px 16px 10px; font-size: 0.84rem; } }

  .wordmark {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: end;
    column-gap: 6px;
    margin: 8px 0 14px;
  }
  .wordmark .big {
    font-family: var(--display);
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.06em;
    color: #2a2a28;
    padding-bottom: 8px;
    border-bottom: 1px solid #555;
  }
  .wordmark .ext { font-size: 0.9rem; letter-spacing: 0.3em; padding-bottom: 14px; }
  .wordmark .est { grid-column: 1; text-align: center; color: var(--ink-soft); font-size: 0.86rem; padding-top: 4px; }

  .term-out :global(.ln) { white-space: pre-wrap; word-break: break-word; }
  .term-out :global(.ps1), .ps1 { color: var(--ink-mute); }
  .term-out :global(.cmd), .cmd { color: var(--orange-ink); }
  .term-out :global(.k) { color: var(--ink-mute); }
  .term-out :global(.muted) { color: var(--ink-mute); }
  .term-out :global(.err) { color: var(--red); }
  .term-out :global(a) { border-bottom: 1px dotted var(--ink-mute); }
  .term-out :global(a:hover) { color: var(--orange-ink); border-bottom-color: var(--orange); }

  .kv { display: grid; grid-template-columns: max-content 1fr; column-gap: 3ch; margin: 4px 0 6px; }
  .kv dt { color: var(--ink); }
  .kv dd a { border-bottom: 1px dotted var(--ink-mute); }

  .term-prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
  }
  @media (max-width: 600px) { .term-prompt { padding: 12px 16px; } }
  .caret { color: var(--orange-ink); font-weight: 600; }
  .term-prompt input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.92rem;
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
    caret-color: var(--orange-ink);
  }
  .term-prompt input::placeholder { color: var(--ink-mute); }
  .term-prompt:focus-within { box-shadow: inset 0 2px 0 -1px var(--orange); }

  .term-hints { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 0.78rem; color: var(--ink-mute); padding: 0 4px; }
  .term-hints kbd {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 1px 6px;
    margin-right: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--well);
    box-shadow: var(--key-shadow);
  }
  @media (hover: none) { .term-hints { display: none; } }
</style>
