---
/**
 * 9×9 pixel-art glyphs drawn as SVG rects. Decorative only.
 * `#` = filled pixel, `+` = half-tone pixel, `.` = empty.
 */
const ICONS = {
  chip: [
    '..#.#.#..',
    '.#######.',
    '##.....##',
    '.#.+++.#.',
    '##.+++.##',
    '.#.+++.#.',
    '##.....##',
    '.#######.',
    '..#.#.#..',
  ],
  db: [
    '..#####..',
    '.#+++++#.',
    '.#######.',
    '.#.....#.',
    '.#######.',
    '.#.....#.',
    '.#######.',
    '.#.....#.',
    '..#####..',
  ],
  cloud: [
    '.........',
    '...###...',
    '..#####..',
    '.######+.',
    '#########',
    '#########',
    '.#######.',
    '.........',
    '.........',
  ],
  terminal: [
    '#########',
    '#+++++++#',
    '#.......#',
    '#.#.....#',
    '#..#....#',
    '#.#..##.#',
    '#.......#',
    '#########',
    '..+++++..',
  ],
  spark: [
    '....#....',
    '....#....',
    '...###...',
    '..##+##..',
    '###+++###',
    '..##+##..',
    '...###...',
    '....#....',
    '....#....',
  ],
  bug: [
    '..#...#..',
    '...#.#...',
    '..#####..',
    '###+#+###',
    '..#####..',
    '###+#+###',
    '..#####..',
    '.#..#..#.',
    '#.......#',
  ],
  boxes: [
    '####.####',
    '#++#.#++#',
    '####.####',
    '.........',
    '####.####',
    '#++#.#++#',
    '####.####',
    '.........',
    '.........',
  ],
  lock: [
    '...###...',
    '..#...#..',
    '..#...#..',
    '.#######.',
    '.###.###.',
    '.###.###.',
    '.####+##.',
    '.#######.',
    '.........',
  ],
  layers: [
    '#########',
    '#+..#...#',
    '#...#...#',
    '#...#..+#',
    '#########',
    '#+..#...#',
    '#...#...#',
    '#...#..+#',
    '#########',
  ],
  rocket: [
    '....#....',
    '...###...',
    '..##+##..',
    '..##+##..',
    '..#####..',
    '.#######.',
    '#.#####.#',
    '...+.+...',
    '..+...+..',
  ],
  people: [
    '.##...##.',
    '####.####',
    '####.####',
    '.##...##.',
    '.........',
    '####.####',
    '####.####',
    '#++#.#++#',
    '.........',
  ],
  lens: [
    '.####....',
    '#++++#...',
    '#+...#...',
    '#....#...',
    '#....#...',
    '.#####...',
    '.....##..',
    '......##.',
    '.......##',
  ],
  book: [
    '.........',
    '###...###',
    '#++#.#++#',
    '#++#.#++#',
    '#++#.#++#',
    '#++#.#++#',
    '####.####',
    '...###...',
    '.........',
  ],
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 36 } = Astro.props;
const rows = ICONS[name];
const pixels = rows.flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '.' ? [] : [{ x, y, half: c === '+' }])),
);
---

<svg
  class="pixel-icon"
  width={size}
  height={size}
  viewBox="0 0 9 9"
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" opacity={p.half ? 0.45 : 1} />)}
</svg>

<style>
  .pixel-icon { display: block; fill: currentColor; color: #5a5a56; }
</style>
